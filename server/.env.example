PORT=3001
CLIENT_URL=http://localhost:5173

# Mettre à 1 UNIQUEMENT si l'app tourne derrière un proxy inverse (nginx, Heroku,
# Railway…) qui réécrit X-Forwarded-For. Sinon le client pourrait forger cet en-tête
# et contourner le rate limiting du formulaire de contact.
TRUST_PROXY=0

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Email contact (Gmail)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
